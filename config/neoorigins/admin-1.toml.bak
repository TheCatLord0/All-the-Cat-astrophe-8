unique_origin_layers = []
debug_compat_actions = false
debug_power_loading = false

[dimension_restrictions]
	rules = []

[command_powers]
	#Command roots forbidden from power execution.
	command_power_blacklist = ["op", "deop", "ban", "ban-ip", "pardon", "pardon-ip", "kick", "whitelist", "stop", "save-all", "save-off", "save-on", "setidletimeout", "debug", "perf", "datapack", "reload"]

[compat_filtering]
	#Minimum ratio of loaded powers (0.0-1.0) for an addon origin to appear.
	# Default: 0.5
	# Range: 0.0 ~ 1.0
	min_power_ratio = 0.5

[commands]
	#Allow non-OP players to run /neoorigins get <player> to look up
	#another player's origin. Operators (permission level 2) can always
	#run it regardless of this setting. Set to false to make origins
	#visible only to staff.
	public_origin_get = true
